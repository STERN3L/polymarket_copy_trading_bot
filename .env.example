# Copy this file to `.env` and fill in your values. NEVER commit `.env`.

# --- Target -----------------------------------------------------------------
# Polymarket wallet (proxy address shown on the trader's profile) to copy.
TARGET_WALLET=0x0000000000000000000000000000000000000000

# --- Your account (only required for live trading) --------------------------
# Private key of the wallet that signs your orders. Use a dedicated wallet!
POLYMARKET_PRIVATE_KEY=
# Address shown on your Polymarket profile (holds your USDC).
POLYMARKET_FUNDER_ADDRESS=
# 0 = EOA, 1 = email/Magic login, 2 = browser wallet (MetaMask, ...)
POLYMARKET_SIGNATURE_TYPE=2

# --- Copy sizing & risk ------------------------------------------------------
# Your order = target order * COPY_RATIO_PERCENT / 100, capped at MAX_ORDER_USDC
COPY_RATIO_PERCENT=10
MIN_ORDER_USDC=1
MAX_ORDER_USDC=100
MAX_SLIPPAGE_PERCENT=2

# --- Runtime -----------------------------------------------------------------
POLL_INTERVAL_SECONDS=30
# Keep `true` until you have validated the bot's behaviour.
DRY_RUN=true
JOURNAL_PATH=data/copy_trades.csv
